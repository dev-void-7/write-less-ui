{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "declaration": true,
        // "declarationDir": "./dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
    },
    "include": ["src", "dev"],
}
